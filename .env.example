# Database
# Local dev (default, zero config): SQLite file on disk.
DATABASE_URL="file:./prisma/dev.db"
# Production (Vercel + Neon/Vercel Postgres/Supabase): switch the
# datasource provider in prisma/schema.prisma to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Email of the account allowed to view the /feedback admin inbox.
ADMIN_EMAIL="jbdpalle@gmail.com"

# Future: AI assistant integration (theme engine runs rule-based without this)
# ANTHROPIC_API_KEY=""
