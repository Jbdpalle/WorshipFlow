# Database — Postgres, local or production (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/worshipflow"
# Production example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Email of the account allowed to view the /feedback admin inbox.
ADMIN_EMAIL="jbdpalle@gmail.com"

# Optional: enables Team → "Import Roster" from a photo/screenshot (image
# roster import only — spreadsheet/.xlsx/.csv roster import works without
# this). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=""
