// WorshipFlow database schema.
// Postgres-backed (Neon, Vercel Postgres, Supabase, or any standard
// Postgres instance) — point DATABASE_URL at it. See README for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity & Tenancy ──────────────────────────────────────────────
// A User authenticates. A Church is the top-level tenant boundary. A
// User's access to a Church is granted by Membership (not by owning a
// Team), so one person can belong to more than one church, and a
// church can hold more than one Team (e.g. a band and a tech crew).
// A Team is the working group everything else (songs, sets, rehearsals)
// is scoped to, same as before — it now just hangs off a Church.

enum ChurchRole {
  OWNER
  ADMIN
  LEADER
  MEMBER
}

// PRO lifts the limits in lib/plans/limits.ts; no billing integration yet.
// INDIVIDUAL and GROUP are reserved for future pricing tiers — not yet
// defined, not yet enforced anywhere, placeholders only until pricing
// launches. During the testing/beta phase, lib/plans/limits.ts doesn't
// enforce Free-plan limits regardless of this field's value, and only the
// two accounts in lib/auth/super-admin.ts can change a team's plan at all
// (see lib/actions/plan.ts) — there is no self-serve checkout.
enum TeamPlan {
  FREE
  INDIVIDUAL
  GROUP
  PRO
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime? // set at creation for demo accounts only; null for everyone else
  // Guided-tour progress for the demo walkthrough — null/0 means never started.
  tourStatus    String?   // "active" | "skipped" | "completed"
  tourStep      Int       @default(0)
  createdAt     DateTime  @default(now())
  // Which church requireUser() resolves to for a user with more than one
  // Membership — set when an invite is accepted, so a person who already
  // had an account elsewhere lands in the church they just joined instead
  // of silently staying on their oldest one. Null means "no explicit
  // choice yet" — requireUser() falls back to the oldest membership, same
  // as before this field existed. There's still no UI to change it any
  // other time, which is the real remaining gap (a proper church switcher).
  currentChurchId String?

  currentChurch     Church?          @relation("UserCurrentChurch", fields: [currentChurchId], references: [id], onDelete: SetNull)
  ownedChurches     Church[]         @relation("ChurchOwner")
  churchMemberships Membership[]
  ownedTeams        Team[]           @relation("TeamOwner")
  memberships       TeamMember[]
  personalNotes     PersonalNote[]
  rehearsalChecks   RehearsalCheck[]
  arrangementChanges ArrangementChange[]
  feedback          Feedback[]
  changeLogs        ChangeLog[]
  acceptedInvites   Invite[]
  usabilityEvents   UsabilityEvent[]
  passwordResets        PasswordReset[] @relation("PasswordResetUser")
  passwordResetsCreated PasswordReset[] @relation("PasswordResetCreatedBy")
}

// A leader-generated, single-use link for resetting one team member's
// password — the same "generate a token, copy and share the link
// yourself" pattern as Invite, since WorshipFlow has no email-sending
// capability to offer a self-serve "forgot password" flow instead.
// createdByUserId is the leader who generated it, kept for an audit trail;
// it's nullable (SetNull) so deleting that leader's account never blocks
// deleting this row.
model PasswordReset {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique @default(cuid())
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String?

  user          User  @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("PasswordResetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Church {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner             User         @relation("ChurchOwner", fields: [ownerId], references: [id])
  memberships       Membership[]
  teams             Team[]
  invites           Invite[]
  usersCurrentlyHere User[]      @relation("UserCurrentChurch")

  @@index([ownerId])
}

// A User's role and access within one Church. Distinct from
// TeamMemberRole below: this governs permissions (who can manage the
// church), TeamMemberRole is the musical/functional roles a roster
// entry plays (Drums, Vocals, ...).
model Membership {
  id        String     @id @default(cuid())
  userId    String
  churchId  String
  role      ChurchRole @default(MEMBER)
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id])
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([userId, churchId])
  @@index([churchId])
}

// An outstanding (or resolved) invitation for a specific email to join an
// existing Church/Team — the only way, besides direct DB access, to link a
// second real login to a team that already exists. Optionally targets a
// specific existing TeamMember roster row (so accepting the invite links
// TeamMember.userId instead of creating a duplicate roster entry).
model Invite {
  id               String     @id @default(cuid())
  churchId         String
  teamId           String
  teamMemberId     String?
  email            String
  role             ChurchRole @default(MEMBER)
  token            String     @unique @default(cuid())
  createdAt        DateTime   @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?

  church     Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  acceptedBy User?       @relation(fields: [acceptedByUserId], references: [id])

  @@index([churchId])
  @@index([teamId])
  @@index([email])
}

model Team {
  id        String   @id @default(cuid())
  churchId  String
  name      String
  ownerId   String
  plan      TeamPlan @default(FREE) // FREE limits enforced in lib/plans; PRO lifts them, no billing wired yet
  createdAt DateTime @default(now())

  church  Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members TeamMember[]
  songs   Song[]
  sets    WorshipSet[]
  invites Invite[]
  usabilityEvents UsabilityEvent[]

  @@index([churchId])
  @@index([ownerId])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  userId     String?
  name       String
  // Primary/display role, kept for the scheduling UI and imports that
  // still expect one label per person; `roles` is the full multi-role
  // set and the source of truth for "who can do what."
  role       String
  instrument String?
  bio        String?
  createdAt  DateTime @default(now())

  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id])
  roles         TeamMemberRole[]
  assignments   SongAssignment[]
  personalNotes PersonalNote[]
  roleNoteDirections SongRoleNote[]
  setAssignments     SetTeamMember[]
  invites            Invite[]

  @@index([teamId])
}

// A member can play more than one role (e.g. Acoustic Guitar AND
// Backing Vocal), so roles are a set rather than a single field.
model TeamMemberRole {
  id           String @id @default(cuid())
  teamMemberId String
  role         String

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, role])
  @@index([teamMemberId])
}

// ── Songs & Library ─────────────────────────────────────────────────

model Song {
  id                String   @id @default(cuid())
  teamId            String
  title             String
  artist            String?
  key               String?
  bpm               Int?
  timeSignature     String?  @default("4/4")
  durationSeconds   Int?
  energy            String?  // low | medium | high
  themeCategory     String?  // e.g. "God's Love", "Cross / Sacrifice"
  worshipType       String?  // High Praise | Med Praise | Praise/Worship | Worship | Medium Worship | Slow Worship — see lib/songs/constants.ts WORSHIP_TYPES
  biblicalConnection String?
  lyricsSummary     String?  // no full copyrighted lyrics stored
  notes             String?
  visionNote        String?  // "Where are we taking this song?" — free-form leadership direction, distinct from `notes`
  youtubeUrl        String?  // reference recording — "listen to this version" for the team
  spotifyUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tags              SongTag[]
  themeCategories   SongThemeCategory[]
  sections          SongSection[]
  bibleRefs         BibleReference[]
  setSongs          SetSong[]
  rehearsals        Rehearsal[]
  personalNotes     PersonalNote[]
  changeLogs        ChangeLog[]
  arrangementChanges ArrangementChange[]
  anchorForSets     WorshipSet[]       @relation("AnchorSong")

  @@index([teamId])
}

model SongTag {
  id     String @id @default(cuid())
  songId String
  label  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@unique([songId, label])
}

// A song can genuinely fit more than one theme category (2-5 is typical),
// unlike the legacy singular `Song.themeCategory` field, which stays as the
// one "primary" category for backward compatibility with existing data and
// lib/songs/theme-engine.ts matching. `label` is one of THEME_CATEGORIES'
// labels (lib/songs/constants.ts), not freeform text — that's what SongTag
// is for.
model SongThemeCategory {
  id     String @id @default(cuid())
  songId String
  label  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@unique([songId, label])
}

model SongSection {
  id            String  @id @default(cuid())
  songId        String
  label         String // Intro, Verse 1, Chorus, Bridge, ...
  order         Int
  barCount      Int?
  repeatCount   Int?    // e.g. "Bridge x4" without four separate section rows
  dynamics      String? // Intimate | Light | Building | Strong | Full — a simple label, not a mixing console
  isFreeform    Boolean @default(false) // spontaneous/unstructured (e.g. Free Worship) — de-emphasizes the usual structure fields rather than adding new ones
  lyricsChords  String? // raw chords/lyrics text for this section, e.g. from a PDF import

  song               Song                @relation(fields: [songId], references: [id], onDelete: Cascade)
  roleNotes          SongRoleNote[]
  arrangementChanges ArrangementChange[]
  liveForSets        WorshipSet[]

  @@index([songId])
}

// Visibility of a role direction: TEAM (default, everyone on the song sees
// it), ROLE (only members who play that role), PERSON (only the specific
// assignee). Personal, author-only notes stay on the separate PersonalNote
// model — this is about scoping a *shared* direction, not a private one.
enum NoteVisibility {
  TEAM
  ROLE
  PERSON
}

// Role is a fixed vocabulary (Worship Leader, Lead Vocal, Acoustic Guitar, ...)
// represented as a plain string so the MVP can extend it without a migration.
model SongRoleNote {
  id           String         @id @default(cuid())
  sectionId    String
  role         String
  content      String
  teamMemberId String?        // optional: directs this at one specific person rather than the whole role
  visibility   NoteVisibility @default(TEAM)
  updatedAt    DateTime       @updatedAt

  section    SongSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@index([teamMemberId])
  // Includes teamMemberId (not just sectionId+role) so two different people
  // sharing a role can each get their own individualized PERSON-scoped note
  // in the same section — Postgres treats NULL as distinct, so the single
  // shared TEAM/ROLE-wide row (teamMemberId IS NULL) keeps working exactly
  // as before.
  @@unique([sectionId, role, teamMemberId])
}

model SongAssignment {
  id           String @id @default(cuid())
  setSongId    String
  teamMemberId String
  role         String

  setSong    SetSong    @relation(fields: [setSongId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@index([setSongId])
  @@index([teamMemberId])
}

// ── Worship Sets / Calendar Events ──────────────────────────────────
// A WorshipSet is a calendar event for a Team: a Sunday service, a
// rehearsal, a special event, a conference session, or a custom type.
// `eventType` is the broad category (drives calendar filtering);
// `serviceType` stays as a free-text sub-label (e.g. "Sunday AM").

enum EventType {
  SERVICE
  MINISTRY_SERVICE
  REHEARSAL
  SPECIAL_EVENT
  CONFERENCE_CAMP
  CUSTOM
}

// Which experience currently owns WorshipSet's live-position fields
// (liveSetSongId/liveSectionId below) — Director Mode is one screen
// reused by both Practice Sessions and the Live Set, so this says which
// of the two a live position in progress actually means. NONE: nobody is
// live right now (the fields may still hold the last position, stale).
enum SetLiveMode {
  NONE
  PRACTICE
  LIVE
}

model WorshipSet {
  id          String    @id @default(cuid())
  teamId      String
  eventType   EventType @default(SERVICE)
  title       String
  theme       String?
  keywords    String? // comma-separated — "Key Words" in the Set Direction UI
  serviceDate DateTime?
  location    String?
  church      String?
  serviceType String?
  leaderName  String?
  notes       String? // whole-set notes — "Leader's Note" in the Set Direction UI
  exaltation  String? // the leader's cues for opening worship — something on their heart, a verse, a prayer — distinct from `notes` (mid-service reference)
  youtubePlaylistUrl String? // whole-set listening playlist, separate from each song's own reference link
  spotifyPlaylistUrl String?
  anchorSongId String? // optional: the one song this service is built around
  archivedAt  DateTime? // set when archived — hidden from the default /sets list, not deleted

  // Live rehearsal position, for polling-based team sync (Director Mode
  // writes these; Rehearsal Mode / My Part poll them). Null when no
  // rehearsal is currently live for this set.
  liveSetSongId String?
  liveSectionId String?
  liveUpdatedAt DateTime?
  // A one-off message the leader broadcasts to everyone following along
  // (Director Mode's "Announce" control) — piggybacks on the same polling
  // channel as the live position above rather than a second sync pathway.
  liveAnnouncement   String?
  liveAnnouncementAt DateTime?

  // Which of Practice/Live currently owns the live-position fields above,
  // and (for PRACTICE) which session. Both Finish Practice and Finish Live
  // Set reset liveMode to NONE and clear activePracticeSessionId/the
  // relevant started/ended timestamp — never a second "whose turn is it"
  // flag anywhere else.
  liveMode                SetLiveMode @default(NONE)
  activePracticeSessionId String?
  // The real Live Set run, distinct from any PRACTICE run through
  // liveMode above — lets the Live Set tab show Ready/Live/Completed
  // without a separate stored status (same "compute it" approach
  // lib/songs/readiness.ts already uses for the four setup stages).
  liveStartedAt DateTime?
  liveEndedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  songs        SetSong[]
  bibleRefs    BibleReference[]
  teamMembers  SetTeamMember[]
  transitions  Transition[]
  anchorSong   Song?            @relation("AnchorSong", fields: [anchorSongId], references: [id], onDelete: SetNull)
  liveSetSong  SetSong?         @relation("LiveSetSong", fields: [liveSetSongId], references: [id], onDelete: SetNull)
  liveSection  SongSection?     @relation(fields: [liveSectionId], references: [id], onDelete: SetNull)
  practiceSessions      PracticeSession[] @relation("SetPracticeSessions")
  activePracticeSession PracticeSession?  @relation("ActivePracticeSession", fields: [activePracticeSessionId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([eventType])
  @@index([anchorSongId])
  @@index([liveSetSongId])
  @@index([liveSectionId])
  @@index([archivedAt])
  @@index([activePracticeSessionId])
}

// The service's roster, assigned once for the whole set instead of
// per-song. SongAssignment (per SetSong) still exists for the optional
// per-song override.
model SetTeamMember {
  id           String @id @default(cuid())
  setId        String
  teamMemberId String
  role         String

  set        WorshipSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([setId, teamMemberId, role])
  @@index([setId])
  @@index([teamMemberId])
}

model SetSong {
  id               String  @id @default(cuid())
  setId            String
  songId           String
  order            Int
  purpose          String? // role in the set flow
  // Deprecated in favor of the Transition model below (kept, not dropped —
  // existing data was migrated forward; see migration
  // 20261002193000_add_transitions). No longer written to by the UI.
  transitionNotes  String?
  overrideKey      String?
  overrideBpm      Int?
  capo             Int?

  set         WorshipSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  song        Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  assignments SongAssignment[]
  rehearsals  Rehearsal[]
  liveForSets WorshipSet[]     @relation("LiveSetSong")
  transitionFrom Transition?   @relation("TransitionFrom")
  transitionsTo  Transition[]  @relation("TransitionTo")

  @@index([setId])
  @@index([songId])
}

// A transition is a first-class object between two adjacent songs in a
// set — not a note attached to one song. One row per "leaving this song"
// slot (@@unique on fromSetSongId), toSetSongId is nullable for the last
// song in a set (nothing to transition into yet). No chord-suggestion or
// auto-transition intelligence here by design — type + a free-form
// direction is the whole model, per the product brief.
enum TransitionType {
  DIRECT
  INSTRUMENTAL
  PAD
  SPOKEN
  PRAYER
  FREE_WORSHIP
  COUNT_IN
  PAUSE
  CUSTOM
}

model Transition {
  id            String         @id @default(cuid())
  setId         String
  fromSetSongId String         @unique
  toSetSongId   String?
  type          TransitionType @default(CUSTOM)
  direction     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  set         WorshipSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  fromSetSong SetSong    @relation("TransitionFrom", fields: [fromSetSongId], references: [id], onDelete: Cascade)
  toSetSong   SetSong?   @relation("TransitionTo", fields: [toSetSongId], references: [id], onDelete: SetNull)

  @@index([setId])
  @@index([toSetSongId])
}

// ── Bible References ────────────────────────────────────────────────

model BibleReference {
  id        String  @id @default(cuid())
  reference String // e.g. "1 Corinthians 13:4-8"
  text      String? // optional user-entered text; never auto-populated copyrighted text
  setId     String?
  songId    String?

  set  WorshipSet? @relation(fields: [setId], references: [id], onDelete: Cascade)
  song Song?       @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([songId])
}

// ── Rehearsals ───────────────────────────────────────────────────────

enum PracticeSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

// A dated, named, whole-set practice gathering — the one thing nothing
// else in this schema represents. Rehearsal (below) is per-song, created
// implicitly whenever Director Mode opens a song, with no name, date or
// status of its own; a PracticeSession groups the Rehearsal rows created
// during it (see Rehearsal.practiceSessionId) so "songs practiced" and
// "experiments tried" are derived from existing data, never duplicated.
// Its live position reuses WorshipSet.liveSetSongId/liveSectionId (via
// WorshipSet.liveMode = PRACTICE while it's the activePracticeSessionId)
// — Director Mode itself is not reimplemented or forked.
model PracticeSession {
  id          String                @id @default(cuid())
  setId       String
  name        String
  status      PracticeSessionStatus @default(PLANNED)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  notes       String?
  createdAt   DateTime              @default(now())

  set          WorshipSet   @relation("SetPracticeSessions", fields: [setId], references: [id], onDelete: Cascade)
  activeForSet WorshipSet[] @relation("ActivePracticeSession")
  rehearsals   Rehearsal[]

  @@index([setId])
}

model Rehearsal {
  id                String   @id @default(cuid())
  setSongId         String?
  songId            String
  bpmUsed           Int?
  summary           String?
  occurredAt        DateTime @default(now())
  practiceSessionId String?
  // Distinct SongSection ids visited while this per-song Rehearsal row was
  // current during a practice session — appended to by setLivePosition,
  // never deduped elsewhere, so "sections covered" on the Finish Practice
  // summary is a real count instead of an estimate.
  sectionsVisited   String[] @default([])

  setSong         SetSong?            @relation(fields: [setSongId], references: [id], onDelete: SetNull)
  song            Song                @relation(fields: [songId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession?    @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)
  notes   RehearsalNote[]
  checks  RehearsalCheck[]
  arrangementChanges ArrangementChange[]

  @@index([songId])
  @@index([setSongId])
  @@index([practiceSessionId])
}

model RehearsalNote {
  id          String @id @default(cuid())
  rehearsalId String
  content     String

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@index([rehearsalId])
}

model RehearsalCheck {
  id          String   @id @default(cuid())
  rehearsalId String
  userId      String
  status      String // practiced | needs_work | confirmed | changed
  createdAt   DateTime @default(now())

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([rehearsalId])
}

// A proposed in-rehearsal change to one role's direction for one section.
// PROPOSED is the "try this" exploratory state; KEEP applies
// `proposedContent` onto the live SongRoleNote.content and marks this row
// KEPT; DISCARD marks it DISCARDED and leaves the live note untouched.
// Distinct from ChangeLog, which is a manually-typed historical journal
// entry and never mutates the live arrangement itself.
enum ArrangementChangeStatus {
  PROPOSED
  KEPT
  DISCARDED
}

model ArrangementChange {
  id              String                  @id @default(cuid())
  songId          String
  sectionId       String
  role            String
  proposedContent String
  previousContent String?
  status          ArrangementChangeStatus @default(PROPOSED)
  rehearsalId     String?
  createdByUserId String?
  createdAt       DateTime                @default(now())
  resolvedAt      DateTime?

  song      Song       @relation(fields: [songId], references: [id], onDelete: Cascade)
  section   SongSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rehearsal Rehearsal? @relation(fields: [rehearsalId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdByUserId], references: [id])

  @@index([songId])
  @@index([sectionId])
  @@index([rehearsalId])
  @@index([status])
}

// Structured "what changed" record, distinct from free-text rehearsal notes.
model ChangeLog {
  id        String   @id @default(cuid())
  songId    String
  userId    String?
  field     String // e.g. "BPM", "Guitar - Verse 1"
  fromValue String?
  toValue   String?
  reason    String?
  createdAt DateTime @default(now())

  song Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([songId])
}

// ── Notes ────────────────────────────────────────────────────────────

// Private notes, visible only to the author. Distinct from leader direction
// (SongRoleNote) and team notes (Song.notes / WorshipSet.notes).
model PersonalNote {
  id           String   @id @default(cuid())
  userId       String
  teamMemberId String?
  songId       String?
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id])
  song       Song?       @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([songId])
}

// ── Feedback ─────────────────────────────────────────────────────────

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  type      String // bug | feature | general
  message   String
  page      String?
  rating    Int? // optional 1-5 "how easy was this" — not required, never blocks submission
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

// ── Usability tracking ──────────────────────────────────────────────
// Deliberately minimal: a flat event log, not an analytics platform.
// Each row is one meaningful workflow event (see lib/usability/track.ts
// for the fixed event-name vocabulary) — no page views, no click
// tracking, no IP/device fingerprinting. userId is nullable because a
// few events (e.g. invite acceptance before the account exists) don't
// have one yet at the moment they're logged.
model UsabilityEvent {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  event     String
  entityId  String?
  meta      String? // small JSON string, optional — never free-form PII
  createdAt DateTime @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([teamId])
  @@index([event])
  @@index([createdAt])
}
